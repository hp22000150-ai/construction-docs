{
  "name": "construction-daily-log",
  "version": "0.1.0",
  "description": "공사일지",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "build": "electron-builder --win --x64",
    "build:daiji": "electron-builder --config electron-builder-daiji.json"
  },
  "build": {
    "appId": "com.contentfactory.daily-log",
    "productName": "공사일지",
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
